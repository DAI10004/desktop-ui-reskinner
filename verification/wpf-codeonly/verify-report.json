{
  "target": "wpf-codeonly",
  "skin": "wpf-dark",
  "environment": {
    "compiler": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe",
    "refs": "PresentationFramework/PresentationCore/WindowsBase/System.Xaml (GAC, v4.0_4.0.0.0__31bf3856ad364e35)",
    "screenshot": "ctypes PrintWindow(flag=PW_RENDERFULLCONTENT=2)"
  },
  "detect": {
    "framework_detected": "win32",
    "confidence": "low",
    "signals": [
      "pe-fallback"
    ],
    "note": "detector 未识别 WPF（bug，见下）"
  },
  "commands": [
    {
      "step": "build",
      "cmd": "powershell -File demo-targets\\wpf-codeonly\\build.ps1",
      "exit": 0,
      "output": "WpfDemo.exe (6144 bytes)"
    },
    {
      "step": "before shot",
      "cmd": ".venv\\Scripts\\python.exe verification\\shoot_win.py WpfDemo.exe before.png 'Reskinner WPF Demo'",
      "exit": 0
    },
    {
      "step": "plan dry",
      "cmd": "reskin.py --json plan --target <wpf> --skin <wpf-dark>",
      "exit": 2
    },
    {
      "step": "apply dry no confirm",
      "cmd": "reskin.py --json apply --target . --skin <wpf-dark>",
      "exit": 2,
      "blockers": [
        "框架置信度 low 需 --force"
      ]
    },
    {
      "step": "apply --confirm --force (CWD=target)",
      "cmd": "cd demo-targets\\wpf-codeonly; reskin.py --json apply --target . --skin <abs wpf-dark> --confirm --force",
      "exit": 0,
      "note": "theme.xaml -> #0E1626"
    },
    {
      "step": "after shot",
      "cmd": "shoot_win.py ... after.png",
      "exit": 0
    },
    {
      "step": "rollback",
      "cmd": "reskin.py --json rollback --target .",
      "exit": 0,
      "mismatches": []
    },
    {
      "step": "restored shot",
      "cmd": "shoot_win.py ... restored.png",
      "exit": 0
    }
  ],
  "pixel_assertions": {
    "before": {
      "mean_r": 237.98,
      "mean_g": 238.06,
      "mean_b": 233.92,
      "brightness": 237.57
    },
    "after": {
      "mean_r": 44.96,
      "mean_g": 51.86,
      "mean_b": 65.54,
      "brightness": 51.36
    },
    "restored": {
      "mean_r": 237.98,
      "mean_g": 238.06,
      "mean_b": 233.92,
      "brightness": 237.57
    },
    "brightness_after_lt_0.7_before": true,
    "blue_dominant_after": true,
    "before_vs_restored_diff_pixels": 0,
    "restored_equals_before": true
  },
  "compliance_note": "合法路径=外挂松散 ResourceDictionary(theme.xaml)；BAML 内嵌资源工具箱保持只读/unsupported，不做 IL 改写或签名破坏。",
  "bugs_workarounds": [
    "detect 未识别 code-only WPF（无 PresentationFramework.dll 旁置），误报 framework=win32/low；apply 需 --force。",
    "相对 dst 的 containment 按 CWD 解析的问题同 Qt 靶场（执行时 CWD=target 根）。"
  ],
  "verdict": "SUCCESS"
}